import kotlin.Boolean;
import kotlin.Long;
import kotlin.collections.List;

CREATE TABLE category(
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    -- KMK --> No UNIQUE here, unlike Mihon: subcategories number their `order` per parent,
    -- so a root and its first child are both 0 and every level restarts the count.
    `order` INTEGER NOT NULL,
    flags INTEGER NOT NULL,
    manga_order TEXT AS List<Long> NOT NULL,
    -- KMK -->
    hidden INTEGER NOT NULL DEFAULT 0,
    parent_id INTEGER NOT NULL DEFAULT 0,
    -- KMK <--
    -- KMK --> 0 means "unknown, predates tracking"; sorting falls back to id
    -- for those, so legacy rows are not all stamped with the migration date.
    date_added INTEGER NOT NULL DEFAULT 0,
    date_modified INTEGER NOT NULL DEFAULT 0,
    -- KMK --> NULL means this category is not bound to any tracker status, so a
    -- status change never adds to or removes from it.
    track_status INTEGER,
    -- KMK <--
    -- KMK --> Days between library updates for entries in this category.
    -- NULL inherits the global interval, which is how every existing category
    -- must behave after this lands. Days rather than hours because the
    -- request is phrased in days and FetchInterval already works in days.
    update_interval INTEGER,
    -- KMK --> Role of a subcategory (author, artist, ...). NULL is unclassified, so no
    -- existing row changes character. Appended last to match migration 65's ALTER, which
    -- can only add a column at the end of the physical table.
    type INTEGER,
    -- KMK <--
    -- SY --> SyncYomi protocol v2 identity (appended to match migration 67 ALTER order).
    uid INTEGER NOT NULL DEFAULT 0,
    version INTEGER NOT NULL DEFAULT 0,
    last_modified_at INTEGER NOT NULL DEFAULT 0,
    is_syncing INTEGER NOT NULL DEFAULT 0
    -- SY <--
);

-- Insert system category
INSERT OR IGNORE INTO category(id, name, `order`, flags, manga_order, hidden, parent_id) VALUES (0, "", -1, 0, "", 0, 0);
-- Disallow deletion of default category
CREATE TRIGGER IF NOT EXISTS system_category_delete_trigger BEFORE DELETE
ON category
BEGIN SELECT CASE
    WHEN old.id <= 0 THEN
        RAISE(ABORT, "System category can't be deleted")
    END;
END;

-- SY -->
CREATE TRIGGER insert_category_uid AFTER INSERT ON category
BEGIN
    UPDATE category
    SET uid = CASE WHEN uid = 0 THEN abs(random()) ELSE uid END,
        last_modified_at = CASE WHEN last_modified_at = 0 THEN strftime('%s', 'now') ELSE last_modified_at END
    WHERE id = new.id;
END;

CREATE TRIGGER update_category_version AFTER UPDATE ON category
WHEN new.is_syncing = 0 AND (
    new.name != old.name OR
    new.`order` != old.`order` OR
    new.flags != old.flags OR
    new.hidden != old.hidden OR
    new.parent_id != old.parent_id OR
    new.track_status IS NOT old.track_status OR
    new.update_interval IS NOT old.update_interval OR
    new.type IS NOT old.type
)
BEGIN
    UPDATE category
    SET version = version + 1,
        last_modified_at = strftime('%s', 'now')
    WHERE id = new.id;
END;
-- SY <--

-- Keyed on the primary key, so there is never more than one row to return
getCategory:
SELECT id, name, `order`, flags, hidden, parent_id, date_added, date_modified, track_status, update_interval, type,
    uid, version, last_modified_at, is_syncing
FROM category
WHERE id = :id;

getCategories:
SELECT
id AS id,
name,
`order` AS `order`,
flags AS flags,
-- KMK -->
hidden,
parent_id,
date_added,
date_modified,
track_status,
update_interval,
type,
-- KMK <--
-- SY -->
uid, version, last_modified_at, is_syncing
-- SY <--
FROM category
ORDER BY `order`;

getCategoriesByMangaId:
SELECT
C.id AS id,
C.name,
C.`order` AS `order`,
C.flags AS flags,
-- KMK -->
C.hidden,
C.parent_id,
C.date_added,
C.date_modified,
C.track_status,
C.update_interval,
C.type,
-- KMK <--
-- SY -->
C.uid, C.version, C.last_modified_at, C.is_syncing
-- SY <--
FROM category C
JOIN manga_category MC
ON C.id = MC.category_id
WHERE MC.manga_id = :mangaId;

-- KMK -->
getSubcategories:
SELECT
id AS id,
name,
`order` AS `order`,
flags,
hidden,
parent_id,
date_added,
date_modified,
track_status,
update_interval,
type,
uid, version, last_modified_at, is_syncing
FROM category
WHERE parent_id = :parentId
ORDER BY `order`;

getTopLevelCategories:
SELECT
id AS id,
name,
`order` AS `order`,
flags,
hidden,
parent_id,
date_added,
date_modified,
track_status,
update_interval,
type,
uid, version, last_modified_at, is_syncing
FROM category
WHERE parent_id = 0
ORDER BY `order`;

getMangaIdsInCategoryTree:
SELECT MC.manga_id
FROM manga_category MC
JOIN category C ON C.id = MC.category_id
WHERE C.id = :categoryId OR C.parent_id = :categoryId;

deleteOrphanedSubcategories:
DELETE FROM category
WHERE parent_id != 0 AND parent_id NOT IN (SELECT id FROM category);
-- KMK <--

-- KMK --> The position is passed by the caller rather than taken from max(`order`) + 1 here:
-- subcategories number per parent, so the next position is not a table-wide fact.
insert:
INSERT INTO category(name, `order`, flags, manga_order, hidden, parent_id, type, date_added, date_modified)
VALUES (:name, :order, :flags, "", :hidden, :parentId, :type, strftime('%s', 'now'), strftime('%s', 'now'));

-- SY --> Sync restore: adopt the server's identity and timestamps without bumping local version.
insertSync:
INSERT INTO category(
    name, `order`, flags, manga_order, hidden, parent_id, type,
    date_added, date_modified, uid, version, last_modified_at, is_syncing
)
VALUES (
    :name, :order, :flags, "", :hidden, :parentId, :type,
    strftime('%s', 'now'), strftime('%s', 'now'), :uid, :version, :lastModifiedAt, 1
);

updateSync:
UPDATE category SET
    name = :name,
    `order` = :order,
    flags = :flags,
    hidden = :hidden,
    parent_id = :parentId,
    type = :type,
    uid = :uid,
    version = :version,
    last_modified_at = :lastModifiedAt,
    is_syncing = 1
WHERE id = :id;

resetIsSyncing:
UPDATE category
SET is_syncing = 0
WHERE is_syncing = 1;
-- SY <--

delete:
DELETE FROM category
WHERE id = :id;

-- KMK --> One statement for the partial update the reorder/rename/settings flows share;
-- coalesce assigns a value but cannot clear one (NULL means "leave alone"), which is what
-- the standalone updateTrackStatus / updateUpdateInterval / updateType statements are for.
update:
UPDATE category
SET name = coalesce(:name, name),
    `order` = coalesce(:order, `order`),
    flags = coalesce(:flags, flags),
    hidden = coalesce(:hidden, hidden),
    parent_id = coalesce(:parentId, parent_id),
    -- Same partial-update rule as the other columns: coalesce assigns a role but cannot
    -- clear one (NULL means "leave alone"), which is what the standalone updateType
    -- statement is for.
    type = coalesce(:type, type),
    -- Only a rename counts: reordering and flag toggles go through this same
    -- statement and would otherwise dominate a "date modified" sort.
    date_modified = CASE
        WHEN :name IS NOT NULL AND :name != name THEN strftime('%s', 'now')
        ELSE date_modified
    END
WHERE id = :id;
-- KMK <--

updateAllFlags:
UPDATE category
SET flags = :flags;

-- KMK --> Deliberately not folded into `update`: that statement's partial-update idiom is
-- coalesce(:param, col), which cannot express "unbind this category" because NULL would
-- mean "leave it alone" rather than "set it to nothing". Binding and unbinding need their
-- own statement that assigns the value unconditionally.
updateTrackStatus:
UPDATE category
SET track_status = :trackStatus
WHERE id = :id;

-- Same reasoning as updateTrackStatus: assigning unconditionally is what lets NULL clear the
-- interval back to inheriting the global one.
updateUpdateInterval:
UPDATE category
SET update_interval = :updateInterval
WHERE id = :id;

-- Same reasoning as updateTrackStatus: only an unconditional assignment can express
-- clearing a role back to unclassified; the coalesce idiom would treat NULL as "leave alone".
updateType:
UPDATE category
SET type = :type
WHERE id = :id;
-- KMK <--

selectLastInsertedRowId:
SELECT last_insert_rowid();
