deleteById:
DELETE FROM manga WHERE id = :id;
-- SY <--

-- KMK --> Small projections for the callers that only need one facet of the library. The full
-- libraryView aggregate (chapter counting over every chapter row, four count(DISTINCT) temp
-- b-trees, the blacklist instr() filters and the UNION for the merged source) runs per query,
-- so a consumer that only wants titles, covers or per-category counts should never pay it.
-- Custom-edited fields are folded in with the same coalesce/nullif rule the Manga model's
-- @Transient initialiser applies: a blank edit means "not set", so fall back to the source row.
getFavoriteTitles:
SELECT coalesce(nullif(cm.title, ''), M.remote_title) AS title
FROM manga M
LEFT JOIN custom_manga_info cm ON cm.manga_id = M.id
WHERE M.user_favorite_at IS NOT NULL;

getFavoriteMangaIdByTitle:
SELECT M.id AS mangaId
FROM manga M
LEFT JOIN custom_manga_info cm ON cm.manga_id = M.id
WHERE M.user_favorite_at IS NOT NULL
AND lower(coalesce(nullif(cm.title, ''), M.remote_title)) = lower(:title)
LIMIT 1;

getFavoriteCovers:
SELECT
    M.id AS mangaId,
    coalesce(nullif(cm.thumbnail_url, ''), M.remote_cover) AS thumbnailUrl
FROM manga M
LEFT JOIN custom_manga_info cm ON cm.manga_id = M.id
WHERE M.user_favorite_at IS NOT NULL;

-- How many library entries each category holds, counted where the assignment lives instead of
-- re-deriving it from group_concat after materializing the whole library.
getFavoriteCategoryCounts:
SELECT
    mc.category_id AS categoryId,
    count(*) AS mangaCount
FROM manga_category mc
JOIN manga M ON M.id = mc.manga_id
WHERE M.user_favorite_at IS NOT NULL
GROUP BY mc.category_id;

-- Each library entry paired with one category membership, for scoping a whole-library
-- operation (the CSV export) by category. Entries with no membership row are absent,
-- which is how "Default" (uncategorized) is recognized.
getFavoriteCategoryPairs:
SELECT
    mc.manga_id AS mangaId,
    mc.category_id AS categoryId
FROM manga_category mc
JOIN manga M ON M.id = mc.manga_id
WHERE M.user_favorite_at IS NOT NULL;
-- KMK <--

selectLastInsertRow:
SELECT
    id, source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
    remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
    user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
    state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
    state_cover_last_modified, state_initialized,
    last_modified_at, favorite_modified_at, version, is_syncing,
    scanlator_priority, blacklisted_chapters, reread_count, rereading, reread_started_at,
    scanlator_range_rules, is_light_novel
FROM manga
WHERE id = last_insert_rowid();

getIdByUrlAndSource:
SELECT id
FROM manga
WHERE remote_url = :url AND source_id = :source;
