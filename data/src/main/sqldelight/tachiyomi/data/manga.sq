getDuplicateLibraryManga:
WITH
track_dupes AS (
    SELECT DISTINCT T2.manga_id
    FROM manga_track T1
    JOIN manga_track T2
    ON T1.tracker_id = T2.tracker_id
    AND T1.remote_id = T2.remote_id
    AND T1.remote_id != 0
    AND T1.manga_id != T2.manga_id
    WHERE T1.manga_id = :id
)
SELECT
    M.id, M.source_id, M.remote_url, M.remote_title, M.remote_author, M.remote_artist,
    M.remote_description, M.remote_genre, M.remote_status, M.remote_cover,
    M.remote_update_strategy, M.remote_memo, M.user_favorite_at, M.user_notes,
    M.user_reader_flags, M.user_chapter_flags, M.state_chapter_last_update,
    M.state_chapter_next_update, M.state_chapter_fetch_interval,
    M.state_cover_last_modified, M.state_initialized,
    M.last_modified_at, M.favorite_modified_at, M.version, M.is_syncing,
    M.scanlator_priority, M.blacklisted_chapters, M.reread_count, M.rereading,
    M.reread_started_at, M.scanlator_range_rules, M.is_light_novel,
    (
        SELECT count(*)
        FROM chapter C
        LEFT JOIN excluded_scanlator ES
        ON C.manga_id = ES.manga_id
        AND C.remote_scanlator = ES.scanlator
        WHERE C.manga_id = M.id
        AND ES.scanlator IS NULL
    ) AS chapter_count
FROM manga M
WHERE M.user_favorite_at IS NOT NULL
AND M.id != :id
AND (lower(M.remote_title) LIKE '%' || lower(:remoteTitle) || '%' OR M.id IN (SELECT manga_id FROM track_dupes));

getUpcomingManga:
SELECT
    id, source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
    remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
    user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
    state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
    state_cover_last_modified, state_initialized,
    last_modified_at, favorite_modified_at, version, is_syncing,
    scanlator_priority, blacklisted_chapters, reread_count, rereading, reread_started_at,
    scanlator_range_rules, is_light_novel
FROM manga
WHERE state_chapter_next_update >= :startOfDay
AND user_favorite_at IS NOT NULL
AND remote_status IN :statuses
ORDER BY state_chapter_next_update ASC;

resetViewerFlags:
UPDATE manga
SET user_reader_flags = 0
WHERE user_reader_flags != 0;

-- SY --> Reset the marker the sync flow sets around a restore, so a later sync is not
-- blocked by a stale in-progress flag.
resetIsSyncing:
UPDATE manga
SET is_syncing = 0
WHERE is_syncing = 1;
-- SY <--

-- KMK --> One statement for the whole library: routing this through per-manga updates costs
-- a transaction per entry.
updateLibraryChapterFlags:
UPDATE manga
SET user_chapter_flags = :chapterFlags
WHERE user_favorite_at IS NOT NULL;
-- KMK <--

getSourceIdsWithNonLibraryManga:
SELECT source_id, count(*) AS manga_count
FROM manga
WHERE user_favorite_at IS NULL
GROUP BY source_id;

deleteNonLibraryManga:
DELETE FROM manga
WHERE user_favorite_at IS NULL
AND source_id IN :sourceIds
AND (
    :keepReadManga = 0
    OR NOT EXISTS (
        SELECT 1
        FROM chapter
        WHERE chapter.manga_id = manga.id
        AND (user_read = 1 OR user_last_page_read != 0)
    )
)
-- KMK --> Merged entries are kept even when they fail the conditions above: dropping one
-- orphans its merge references.
AND id NOT IN (
    SELECT DISTINCT manga_id FROM merged WHERE manga_id != merge_id
);
-- KMK <--

-- KMK --> Non-library entries whose on-disk content the discovery screen can list and delete;
-- merge children are excluded because their content belongs to a library merged entry.
getNonLibraryManga:
SELECT * FROM manga
WHERE user_favorite_at IS NULL
AND id NOT IN (
    SELECT DISTINCT manga_id FROM merged WHERE manga_id != merge_id
);
-- KMK <--

insert:
INSERT INTO manga(
    source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
    remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
    user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
    state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
    state_cover_last_modified, state_initialized,
    last_modified_at, version, is_syncing, scanlator_priority, blacklisted_chapters, reread_count,
    rereading, reread_started_at, scanlator_range_rules, is_light_novel
)
VALUES (
    :source, :url, :title, :author, :artist, :description,
    :genre, :status, :thumbnailUrl, :updateStrategy, :memo,
    :favoriteAt, :notes, :viewerFlags, :chapterFlags,
    :lastUpdate, :nextUpdate, :calculateInterval,
    :coverLastModified, :initialized,
    :lastModifiedAt, :version, :isSyncing,
    :scanlatorPriority, :blacklistedChapters, :rereadCount,
    :rereading, :rereadStartedAt, :scanlatorRangeRules, :isLightNovel
);

update:
UPDATE manga SET
    source_id = coalesce(:source, source_id),
    remote_url = coalesce(:url, remote_url),
    remote_title = coalesce(:title, remote_title),
    remote_author = coalesce(:author, remote_author),
    remote_artist = coalesce(:artist, remote_artist),
    remote_description = coalesce(:description, remote_description),
    remote_genre = coalesce(:genre, remote_genre),
    remote_status = coalesce(:status, remote_status),
    remote_cover = coalesce(:thumbnailUrl, remote_cover),
    -- NULL is a real value here (not in the library), which coalesce cannot write
    user_favorite_at = CASE
        WHEN :favoriteSet THEN CASE WHEN :favorite THEN coalesce(:favoriteAt, user_favorite_at, 0) ELSE NULL END
        ELSE user_favorite_at
    END,
    state_chapter_last_update = coalesce(:lastUpdate, state_chapter_last_update),
    state_chapter_next_update = coalesce(:nextUpdate, state_chapter_next_update),
    state_initialized = coalesce(:initialized, state_initialized),
    user_reader_flags = coalesce(:viewer, user_reader_flags),
    user_chapter_flags = coalesce(:chapterFlags, user_chapter_flags),
    state_cover_last_modified = coalesce(:coverLastModified, state_cover_last_modified),
    remote_update_strategy = coalesce(:updateStrategy, remote_update_strategy),
    state_chapter_fetch_interval = coalesce(:calculateInterval, state_chapter_fetch_interval),
    version = coalesce(:version, version),
    last_modified_at = coalesce(:lastModifiedAt, last_modified_at),
    is_syncing = coalesce(:isSyncing, is_syncing),
    user_notes = coalesce(:notes, user_notes),
    remote_memo = coalesce(:memo, remote_memo),
    -- KMK -->
    scanlator_priority = coalesce(:scanlatorPriority, scanlator_priority),
    blacklisted_chapters = coalesce(:blacklistedChapters, blacklisted_chapters),
    reread_count = coalesce(:rereadCount, reread_count),
    rereading = coalesce(:rereading, rereading),
    reread_started_at = coalesce(:rereadStartedAt, reread_started_at),
    scanlator_range_rules = coalesce(:scanlatorRangeRules, scanlator_range_rules),
    is_light_novel = coalesce(:isLightNovel, is_light_novel)
    -- KMK <--
WHERE id = :mangaId;

selectLastInsertedRowId:
SELECT last_insert_rowid();

insertNetworkManga {
    -- A new entry is inserted as the source reported it. An existing one takes the fresh details
    -- only while it is outside the library, so a library entry keeps what the user already has.
    -- KMK: :updateInfo gates the refresh half the same way the previous two-statement form did.
    INSERT INTO manga(
        source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
        remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
        user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
        state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
        state_cover_last_modified, state_initialized,
        last_modified_at, version,
        scanlator_priority, blacklisted_chapters, reread_count, rereading, reread_started_at,
        scanlator_range_rules, is_light_novel
    )
    VALUES (
        :source, :url, :title, :author, :artist, :description,
        :genre, :status, :thumbnailUrl, :updateStrategy, :memo,
        :favoriteAt, '', :viewerFlags, :chapterFlags,
        :lastUpdate, :nextUpdate, :calculateInterval,
        :coverLastModified, :initialized,
        0, :version,
        :scanlatorPriority, :blacklistedChapters, :rereadCount, :rereading, :rereadStartedAt,
        :scanlatorRangeRules, :isLightNovel
    )
    ON CONFLICT(source_id, remote_url) DO UPDATE SET
        remote_title = CASE WHEN :updateTitle THEN excluded.remote_title ELSE remote_title END,
        remote_cover = CASE WHEN :updateCover THEN excluded.remote_cover ELSE remote_cover END,
        remote_author = CASE WHEN :updateDetails THEN excluded.remote_author ELSE remote_author END,
        remote_artist = CASE WHEN :updateDetails THEN excluded.remote_artist ELSE remote_artist END,
        remote_description = CASE WHEN :updateDetails THEN excluded.remote_description ELSE remote_description END,
        remote_genre = CASE WHEN :updateDetails THEN excluded.remote_genre ELSE remote_genre END,
        remote_status = CASE WHEN :updateDetails THEN excluded.remote_status ELSE remote_status END,
        remote_update_strategy = CASE
            WHEN :updateDetails THEN excluded.remote_update_strategy
            ELSE remote_update_strategy
        END,
        remote_memo = excluded.remote_memo,
        state_initialized = :updateDetails
    WHERE user_favorite_at IS NULL
    -- KMK -->
    AND :updateInfo
    -- KMK <--
    ;

    SELECT
        id, source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
        remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
        user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
        state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
        state_cover_last_modified, state_initialized,
        last_modified_at, favorite_modified_at, version, is_syncing,
        scanlator_priority, blacklisted_chapters, reread_count, rereading, reread_started_at,
        scanlator_range_rules, is_light_novel
    FROM manga
    WHERE source_id = :source
    AND remote_url = :url;
}

-- EXH --> Favorites with EXH metadata attached (recommendation inputs)
getEhMangaWithMetadata:
SELECT
    M.id, M.source_id, M.remote_url, M.remote_title, M.remote_author, M.remote_artist,
    M.remote_description, M.remote_genre, M.remote_status, M.remote_cover,
    M.remote_update_strategy, M.remote_memo, M.user_favorite_at, M.user_notes,
    M.user_reader_flags, M.user_chapter_flags, M.state_chapter_last_update,
    M.state_chapter_next_update, M.state_chapter_fetch_interval,
    M.state_cover_last_modified, M.state_initialized,
    M.last_modified_at, M.favorite_modified_at, M.version, M.is_syncing,
    M.scanlator_priority, M.blacklisted_chapters, M.reread_count, M.rereading,
    M.reread_started_at, M.scanlator_range_rules, M.is_light_novel
FROM manga M
INNER JOIN search_metadata
    ON M.id = search_metadata.manga_id
WHERE M.user_favorite_at IS NOT NULL AND (M.source_id = :eh OR M.source_id = :exh);

getIdsOfFavoriteMangaWithMetadata:
SELECT M.id FROM manga M
INNER JOIN search_metadata
    ON M.id = search_metadata.manga_id
WHERE M.user_favorite_at IS NOT NULL;
-- EXH <--

