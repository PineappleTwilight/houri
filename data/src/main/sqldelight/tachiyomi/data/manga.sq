-- Manga (or any of their chapters) modified at or after :since — SyncYomi v2 delta uploads.
getMangasModifiedSince:
SELECT
    M.id, M.source_id, M.remote_url, M.remote_title, M.remote_author, M.remote_artist, M.remote_description,
    M.remote_genre, M.remote_status, M.remote_cover, M.remote_update_strategy, M.remote_memo,
    M.user_favorite_at, M.user_notes, M.user_reader_flags, M.user_chapter_flags,
    M.state_chapter_last_update, M.state_chapter_next_update, M.state_chapter_fetch_interval,
    M.state_cover_last_modified, M.state_initialized,
    M.last_modified_at, M.favorite_modified_at, M.version, M.is_syncing,
    M.scanlator_priority, M.blacklisted_chapters, M.reread_count, M.rereading, M.reread_started_at,
    M.scanlator_range_rules, M.is_light_novel
FROM manga M
WHERE M.user_favorite_at IS NOT NULL
AND (M.last_modified_at >= :since
OR EXISTS (SELECT 1 FROM chapter C WHERE C.manga_id = M.id AND C.last_modified_at >= :since));
-- SY <--

