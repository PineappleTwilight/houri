-- KMK -->
-- Migration 53: Harden subcategories (parent hierarchy, cycles, orphans, index)
-- Parent hierarchy is single-level: parent_id =0 top-level, otherwise must reference a top-level parent
-- Add defensive triggers and repair orphan rows created before strict app-layer validation

-- Index already created in 48, ensure it exists
CREATE INDEX IF NOT EXISTS idx_categories_parent_id ON categories(parent_id);

-- Orphan repair: promote any subcategory whose parent does not exist or is itself a subcategory to top-level
UPDATE categories SET parent_id = 0 WHERE parent_id != 0 AND parent_id NOT IN (SELECT _id FROM categories);
UPDATE categories SET parent_id = 0 WHERE parent_id IN (SELECT _id FROM categories WHERE parent_id != 0);

-- Self-cycle repair
UPDATE categories SET parent_id = 0 WHERE _id = parent_id;

-- Ensure no self-parenting at insert
CREATE TRIGGER IF NOT EXISTS trg_categories_no_self_parent_before_insert
BEFORE INSERT ON categories
FOR EACH ROW
WHEN NEW.parent_id != 0 AND NEW.parent_id = NEW._id
BEGIN
    SELECT RAISE(ABORT, 'category cannot be its own parent');
END;

-- Only top-level categories may be parents (single-level hierarchy)
CREATE TRIGGER IF NOT EXISTS trg_categories_parent_must_be_top_level_before_insert
BEFORE INSERT ON categories
FOR EACH ROW
WHEN NEW.parent_id != 0 AND NEW.parent_id NOT IN (SELECT _id FROM categories WHERE parent_id = 0)
BEGIN
    SELECT RAISE(ABORT, 'parent must be top-level category');
END;

CREATE TRIGGER IF NOT EXISTS trg_categories_no_self_parent_before_update
BEFORE UPDATE OF parent_id ON categories
FOR EACH ROW
WHEN NEW.parent_id != 0 AND NEW.parent_id = NEW._id
BEGIN
    SELECT RAISE(ABORT, 'category cannot be its own parent');
END;

CREATE TRIGGER IF NOT EXISTS trg_categories_parent_must_be_top_level_before_update
BEFORE UPDATE OF parent_id ON categories
FOR EACH ROW
WHEN NEW.parent_id != 0 AND NEW.parent_id NOT IN (SELECT _id FROM categories WHERE parent_id = 0)
BEGIN
    SELECT RAISE(ABORT, 'parent must be top-level category');
END;

-- Keep orphans promoted after parent deletion (extra safety beyond app-layer DeleteCategory handling)
CREATE TRIGGER IF NOT EXISTS trg_categories_promote_orphans_after_delete
AFTER DELETE ON categories
FOR EACH ROW
BEGIN
    UPDATE categories SET parent_id = 0 WHERE parent_id = OLD._id;
    UPDATE categories SET parent_id = 0 WHERE parent_id NOT IN (SELECT _id FROM categories) AND parent_id != 0;
END;

-- Defensive: system category must stay top-level
CREATE TRIGGER IF NOT EXISTS trg_categories_system_must_stay_root
BEFORE UPDATE OF parent_id ON categories
FOR EACH ROW
WHEN OLD._id = 0 AND NEW.parent_id != 0
BEGIN
    SELECT RAISE(ABORT, 'system category must stay top-level');
END;
-- KMK <--
